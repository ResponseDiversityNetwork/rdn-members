// ===== Public.gs =====
/**
 * Builds the PUBLIC spreadsheet that the map reads. It has two tabs, each published to the web as CSV:
 *   public:  one row per approved member who agreed to be on the map, with only the
 *            details they chose to show and coordinates rounded to 2 decimals;
 *   summary: counts over ALL approved members (no names), for the summary on the map page.
 * Column layouts must match README.md ("Public CSV columns").
 */

const PUBLIC_COLS = ['id', 'name', 'institution', 'city', 'country', 'lat', 'lon', 'email', 'website', 'interests',
                     'career_stage', 'approach', 'systems', 'organisms', 'levels', 'stressors', 'regions',
                     'continent', 'photo_url'];
const SUMMARY_MIN_COUNTRY = 3;

function publicRow_(r) {
  const shown = new Set(listOf_(r['Details shown']));
  const show = (label, value) => shown.has(label) ? value : '';
  const attrs = shown.has('Research attributes');
  let web = String(r['Website'] || '').trim();
  if (web && !/^https?:\/\//i.test(web)) web = 'https://' + web;
  const round = x => Math.round(Number(x) * 100) / 100;
  return {
    id: r['Member ID'],
    name: show('Name', r['Name']),
    institution: show('Institution', r['Institution']),
    city: r['City'],
    country: r['Country'],
    lat: round(r['Lat']),
    lon: round(r['Lon']),
    email: show('Email', r['Email']),
    website: shown.has('Website or ORCID link') || shown.has('Website') ? web : '',   // 'Website' = label before 2026-10-14
    interests: show('Research interests', r['Research interests']),
    career_stage: attrs ? r['Career stage'] : '',
    approach: attrs ? r['Research approach'] : '',
    systems: attrs ? r['Systems'] : '',
    organisms: attrs ? r['Organisms'] : '',
    levels: attrs ? r['Level of organisation'] : '',
    stressors: attrs ? r['Stressors studied'] : '',
    regions: attrs ? r['Regions of fieldwork'] : '',
    continent: r['Continent'],
    photo_url: r['Photo URL'] || '',   // uploading a photo is the consent to show it
  };
}

function summaryRows_(approved) {
  const count = (key) => {
    const c = {};
    approved.forEach(r => { const k = String(r[key] || '').trim(); if (k) c[k] = (c[k] || 0) + 1; });
    return c;
  };
  const countries = count('Country'), continents = count('Continent'), stages = count('Career stage');
  const rows = [
    ['members', '', approved.length],
    ['countries', '', Object.keys(countries).length],
    ['continents', '', Object.keys(continents).length],
  ];
  Object.keys(continents).sort().forEach(k => rows.push(['continent', k, continents[k]]));
  Object.keys(stages).sort().forEach(k => rows.push(['career_stage', k, stages[k]]));
  Object.keys(countries).sort().forEach(k => {
    if (countries[k] >= SUMMARY_MIN_COUNTRY) rows.push(['country', k, countries[k]]);
  });
  return rows;
}

/** Replaces a tab's contents with header + rows, all stored as plain text. */
function writeTab_(ss, name, header, rows) {
  const sh = ss.getSheetByName(name) || ss.insertSheet(name);
  sh.clearContents();
  const all = [header].concat(rows).map(r => r.map(v => safeText_(v === null || v === undefined ? '' : v)));
  if (sh.getMaxRows() < all.length + 1) sh.insertRowsAfter(sh.getMaxRows(), all.length + 1 - sh.getMaxRows());
  sh.getRange(1, 1, all.length, header.length).setValues(all);
  // Trim spare rows so the published CSV has no trailing blank lines.
  if (sh.getMaxRows() > all.length + 1) sh.deleteRows(all.length + 2, sh.getMaxRows() - all.length - 1);
}

function rebuildPublic_() {
  const approved = readMembers_().rows.filter(r => r['Approved'] === true);
  const onMap = approved.filter(r => isYes_(r['Show on map']) && r['Lat'] !== '' && r['Lon'] !== '');
  const ss = SpreadsheetApp.openById(prop_('PUBLIC_SS_ID'));
  writeTab_(ss, 'public', PUBLIC_COLS, onMap.map(r => { const p = publicRow_(r); return PUBLIC_COLS.map(c => p[c]); }));
  writeTab_(ss, 'summary', ['metric', 'category', 'count'], summaryRows_(approved));
}

/** Run by hand to rebuild the public sheet now. */
function rebuildPublicNow() {
  rebuildPublic_();
  Logger.log('Public sheet rebuilt.');
}

// ===== Leave.gs =====
/**
 * A short, separate "leave the network" form for people who don't have (or don't want to use)
 * their personal link. Requests are queued in the "Leave requests" tab of the private spreadsheet
 * and only carried out when a curator ticks "Confirmed".
 * (Leaving through the personal link, by ticking "Leave the network", still takes effect at once.)
 *
 * Setup: run setupLeaveForm() once. It creates the form and its trigger and logs its link.
 */

const LEAVE_TAB = 'Leave requests';
const LEAVE_COLS = ['Confirmed', 'Requested', 'Email', 'Name given', 'Message', 'Found', 'Member ID', 'Status', 'Done at'];

function setupLeaveForm() {
  const p = PropertiesService.getScriptProperties();
  if (p.getProperty('LEAVE_FORM_ID')) throw new Error('The leave form already exists: ' + p.getProperty('LEAVE_FORM_URL'));
  const f = FormApp.create('Response Diversity Network: leave the network');
  f.setDescription('Use this form to ask to leave the ' + CONFIG.ORG_NAME + '. A curator will confirm your request, ' +
      'usually within a few days. We then remove you from the member map and the mailing list, delete your entry, ' +
      'and email you to confirm.\n\nIf you have your personal link (the "Edit your response" link, or the link in our emails), ' +
      'you can also leave straight away: open it, tick "Leave the network" on the last page, and submit.')
   .setCollectEmail(false)
   .setAllowResponseEdits(false)
   .setShowLinkToRespondAgain(false)
   .setConfirmationMessage('Thank you. A curator will confirm your request, usually within a few days, ' +
      'and we will email you when it is done.');
  if (typeof f.setPublished === 'function') f.setPublished(true);
  f.addTextItem().setTitle(LQ.EMAIL).setRequired(true)
   .setHelpText('The email address you used for your RDN membership.')
   .setValidation(FormApp.createTextValidation().requireTextIsEmail().setHelpText('Please enter a valid email address.').build());
  f.addTextItem().setTitle(LQ.NAME);
  f.addParagraphTextItem().setTitle(LQ.MESSAGE);
  f.addCheckboxItem().setTitle(LQ.CONFIRM).setRequired(true).setChoiceValues([LEAVE_CONFIRM_OPTION]);
  const url = f.shortenFormUrl(f.getPublishedUrl());
  p.setProperties({LEAVE_FORM_ID: f.getId(), LEAVE_FORM_URL: url});
  ScriptApp.newTrigger('onLeaveRequest').forForm(f).onFormSubmit().create();
  leaveSheet_();
  Logger.log('Leave form, public link: ' + url);
  Logger.log('Leave form, edit:        ' + f.getEditUrl());
}

function leaveSheet_() {
  const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
  let sh = ss.getSheetByName(LEAVE_TAB);
  if (!sh) {
    sh = ss.insertSheet(LEAVE_TAB);
    sh.getRange(1, 1, 1, LEAVE_COLS.length).setValues([LEAVE_COLS]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/** Trigger: a leave request was submitted. Queues it, tells the curator, and acknowledges it. */
function onLeaveRequest(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try {
    const ans = answersOf_(e.response);
    queueLeaveRequest_(ans[LQ.EMAIL], ans[LQ.NAME], ans[LQ.MESSAGE], false);
    // The request is now in the tab; don't keep a second copy in the form.
    try { FormApp.openById(prop_('LEAVE_FORM_ID')).deleteResponse(e.response.getId()); } catch (err) { /* ignore */ }
  } finally {
    lock.releaseLock();
  }
}

/**
 * Adds a request to the Leave requests tab, emails the curator, and acknowledges it to the
 * member. With onlyIfKnown, nothing happens unless the email belongs to a member or the old list.
 * Returns true if a request was queued. (Callers hold the script lock.)
 */
function queueLeaveRequest_(emailIn, nameIn, messageIn, onlyIfKnown) {
  const email = String(emailIn || '').trim().toLowerCase();
  const nameGiven = String(nameIn || '').trim();
  const message = String(messageIn || '').trim();
  if (!email) return false;
  const member = readMembers_().rows.find(r => r['Email'] === email);
  const listed = member ? null : inviteForEmail_(email);
  if (onlyIfKnown && !member && !listed) return false;
  const found = member ? 'Member: ' + member['Name'] + ' (' + member['Member ID'] + ')'
              : listed ? 'Only on the old member list: ' + listed['Name']
              : 'No member with this email address';
  const sh = leaveSheet_();
  sh.appendRow([false, new Date(), email, safeText_(nameGiven), safeText_(message), found,
                member ? member['Member ID'] : '', 'Waiting for curator', '']);
  sh.getRange(sh.getLastRow(), 1).setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());
  if (member || listed) emailLeaveReceived_(email, member ? member['Name'] : listed['Name']);
  emailCuratorLeave_(email, found, message);
  return true;
}

/** Called from onSheetEdit when the curator edits the Leave requests tab. */
function onLeaveSheetEdit_(e) {
  const confirmedCol = LEAVE_COLS.indexOf('Confirmed') + 1;
  const first = e.range.getColumn(), last = first + e.range.getNumColumns() - 1;
  if (confirmedCol < first || confirmedCol > last) return;
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try {
    const sh = leaveSheet_();
    let changed = false;
    for (let r = e.range.getRow(); r < e.range.getRow() + e.range.getNumRows(); r++) {
      const v = sh.getRange(r, 1, 1, LEAVE_COLS.length).getValues()[0];
      const req = {};
      LEAVE_COLS.forEach((c, i) => { req[c] = v[i]; });
      if (req['Confirmed'] !== true || String(req['Status']).indexOf('Done') === 0) continue;
      const status = carryOutLeave_(req);
      sh.getRange(r, LEAVE_COLS.indexOf('Status') + 1, 1, 2).setValues([[status, new Date()]]);
      changed = true;
    }
    if (changed) rebuildPublic_();
  } finally {
    lock.releaseLock();
  }
}

/** Deletes the member (and/or marks them removed on the old list). Returns a status text. */
function carryOutLeave_(req) {
  const email = String(req['Email'] || '').trim().toLowerCase();
  const m = readMembers_();
  const member = (req['Member ID'] && m.rows.find(r => r['Member ID'] === req['Member ID'])) ||
                 m.rows.find(r => r['Email'] === email);
  const listed = inviteForEmail_(email);
  if (member) removeMember_(m.sh, member, [email]);
  if (listed) markInviteState_(listed['Member ref'], 'removed');
  if (!member && !listed) return 'Done: nothing to delete (no member with this email)';
  emailLeft_(member ? member['Email'] : email, member ? member['Name'] : listed['Name']);
  return member ? 'Done: entry deleted' : 'Done: removed from the old member list';
}

// ===== Admin.gs =====
/**
 * Admin functions, run by hand from the Apps Script editor.
 */

const AUTOMATION_HANDLERS = ['onSubmitA', 'onSubmitB', 'onPhotoSubmit', 'onSheetEdit', 'maintenanceTick', 'dailyRebuild', 'onLeaveRequest'];

/** Turns the automation on (safe to run again; it replaces its own triggers). */
function installTriggers() {
  ScriptApp.getProjectTriggers()
    .filter(t => AUTOMATION_HANDLERS.indexOf(t.getHandlerFunction()) >= 0)
    .forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('onSubmitA').forForm(prop_('FORM_A_ID')).onFormSubmit().create();
  ScriptApp.newTrigger('onPhotoSubmit').forForm(prop_('FORM_B_ID')).onFormSubmit().create();
  ScriptApp.newTrigger('onSheetEdit').forSpreadsheet(prop_('PRIVATE_SS_ID')).onEdit().create();
  ScriptApp.newTrigger('maintenanceTick').timeBased().everyMinutes(15).create();
  ScriptApp.newTrigger('dailyRebuild').timeBased().everyDays(1).atHour(3).create();
  const leaveId = PropertiesService.getScriptProperties().getProperty('LEAVE_FORM_ID');
  if (leaveId) ScriptApp.newTrigger('onLeaveRequest').forForm(leaveId).onFormSubmit().create();
  membersSheet_();
  rebuildPublic_();
  Logger.log('Automation is on. Triggers: ' + ScriptApp.getProjectTriggers().map(t => t.getHandlerFunction()).join(', '));
}

/** Turns the automation off (the invitation timer, if any, is left alone). */
function removeTriggers() {
  ScriptApp.getProjectTriggers()
    .filter(t => AUTOMATION_HANDLERS.indexOf(t.getHandlerFunction()) >= 0)
    .forEach(t => ScriptApp.deleteTrigger(t));
  Logger.log('Automation is off.');
}

/**
 * Subscribes every approved member who hasn't opted out to the Sympa list, in one go.
 * Run it once when switching the list on (then set CONFIG.LISTSERV_NOTIFY_EACH to true).
 * Safe to run again: Sympa ignores people who are already subscribed.
 */
function syncMailingList() {
  const rows = readMembers_().rows.filter(r => r['Approved'] === true && isYes_(r['Mailing list']));
  const cmds = rows.map(r => sympaAdd_(r['Email'], r['Name'])).filter(Boolean);
  sendSympa_(cmds);
  Logger.log('Sent ' + cmds.length + ' subscribe commands to ' + CONFIG.SYMPA_ADDRESS +
             '. Sympa reports the result by email to rdn.projectbase@gmail.com.' +
             (CONFIG.LISTSERV_NOTIFY_EACH ? '' : ' Now set LISTSERV_NOTIFY_EACH to true in Config.gs.'));
}
function emailMailingListRequests() { syncMailingList(); }   // old name

/**
 * Deletes ALL member data: every response in both forms, all uploaded photos,
 * the Members tab rows, the response tabs and the public sheet. For clearing test
 * entries before launch. To run it, first change ALLOW_CLEAR to true, then change it back.
 */
const ALLOW_CLEAR = false;

function clearTestData() {
  if (!ALLOW_CLEAR) throw new Error('Safety catch: set ALLOW_CLEAR = true in Admin.gs first (and back to false afterwards).');
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try {
    // Uploaded photos (including any from responses that never reached the Members tab)
    const formB = formFor_('B');
    const uploads = [];
    formB.getResponses().forEach(resp => resp.getItemResponses().forEach(ir => {
      if (ir.getItem().getTitle() === Q.PHOTO) [].concat(ir.getResponse() || []).forEach(id => uploads.push(id));
    }));
    readMembers_().rows.forEach(r => listOf_(r['Photo uploads']).forEach(id => uploads.push(id)));
    deleteUploads_(uploads);
    const folder = DriveApp.getFolderById(prop_('PHOTO_FOLDER_ID'));
    const files = folder.getFiles();
    let photos = 0;
    while (files.hasNext()) { files.next().setTrashed(true); photos++; }

    const nA = formFor_('A').getResponses().length, nB = formB.getResponses().length;
    formFor_('A').deleteAllResponses();
    formB.deleteAllResponses();

    const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
    const props = PropertiesService.getScriptProperties();
    ['RESPONSES_A_TAB', 'RESPONSES_B_TAB'].forEach(k => {
      const sh = ss.getSheetByName(props.getProperty(k) || '');
      if (sh && sh.getLastRow() > 1) deleteRowsSafely_(sh, 2, sh.getLastRow() - 1);
    });
    const leaveId = props.getProperty('LEAVE_FORM_ID');
    if (leaveId) FormApp.openById(leaveId).deleteAllResponses();
    const leaveSh = ss.getSheetByName(LEAVE_TAB);
    if (leaveSh && leaveSh.getLastRow() > 1) deleteRowsSafely_(leaveSh, 2, leaveSh.getLastRow() - 1);
    const members = membersSheet_();
    if (members.getLastRow() > 1) deleteRowsSafely_(members, 2, members.getLastRow() - 1);

    rebuildPublic_();
    Logger.log('Deleted ' + nA + ' + ' + nB + ' responses, ' + uploads.length + ' uploads, ' + photos +
               ' public photos, and all Members rows. Now set ALLOW_CLEAR back to false.');
  } finally {
    lock.releaseLock();
  }
}


/**
 * Handles membership-form submissions that the automation missed (e.g. while its trigger
 * wasn't installed): responses not yet in Members, and edits made after a row was last updated.
 * Safe to run again; nothing is done twice.
 */
function processMissedResponses() {
  const m = readMembers_();
  const updated = {};
  m.rows.forEach(r => { if (r['Response ID']) updated[r['Response ID']] = new Date(r['Updated'] || 0).getTime(); });
  let n = 0;
  formFor_('A').getResponses().forEach(resp => {
    const seen = updated[resp.getId()];
    if (seen === undefined || resp.getTimestamp().getTime() > seen + 1000) {
      handleSubmit_('A', resp);
      n++;
    }
  });
  Logger.log(n ? 'Handled ' + n + ' missed submission(s).' : 'No missed submissions.');
  if (!ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'onSubmitA')) {
    Logger.log('Warning: the onSubmitA trigger is not installed, so new submissions are not handled. Run installTriggers.');
  }
}

/** Logs what the automation knows: triggers, the latest form responses, Members rows, failed emails. */
function diagnose() {
  const L = s => Logger.log(s);
  L('Running as: ' + Session.getEffectiveUser().getEmail());
  L('Triggers: ' + (ScriptApp.getProjectTriggers().map(t => t.getHandlerFunction()).join(', ') || 'none'));
  L('Emails left today: ' + MailApp.getRemainingDailyQuota());
  L('Curator emails go to: ' + CONFIG.CURATOR + '; system administrator: ' + CONFIG.ADMIN);
  const formA = formFor_('A');
  L('Membership form: ' + formA.getTitle() + ' | ' + formA.getPublishedUrl());
  const m = readMembers_();
  const byResp = {};
  m.rows.forEach(r => { byResp[r['Response ID']] = r; });
  const resps = formA.getResponses();
  L('Membership form responses: ' + resps.length + ' (latest 5 below)');
  resps.slice(-5).forEach(resp => {
    const a = answersOf_(resp);
    const row = byResp[resp.getId()];
    L('  ' + resp.getTimestamp() + ' | ' + a[Q.EMAIL] + ' | ref ' + (a[Q.MEMBER_REF] || '-') + ' | ' +
      (row ? 'in Members (updated ' + row['Updated'] + ', approved ' + row['Approved'] + ')' : 'NOT in Members'));
  });
  L('Members rows: ' + m.rows.length + ' (latest 5 below)');
  m.rows.slice(-5).forEach(r => L('  ' + r['Email'] + ' | form ' + r['Form'] + ' | approved ' + r['Approved'] +
                                    ' | updated ' + r['Updated'] + ' | notes: ' + (r['Notes'] || '-')));
  const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
  const failed = ss.getSheetByName('Failed emails');
  if (failed && failed.getLastRow() > 1) {
    L('Failed emails (latest 5):');
    failed.getRange(Math.max(2, failed.getLastRow() - 4), 1, Math.min(5, failed.getLastRow() - 1), 4).getValues()
      .forEach(v => L('  ' + v.join(' | ')));
  } else L('Failed emails: none');
  const inv = ss.getSheetByName(CONFIG.INVITES_TAB);
  L('Invites tab: ' + (inv ? (inv.getLastRow() - 1) + ' rows' : 'none'));
}

/** Fills in "Photo link" for any member rows that lack it (e.g. rows made before the column existed). */
function fillPhotoLinks() {
  const m = readMembers_();
  let n = 0;
  m.rows.forEach(r => {
    if (!r['Photo link'] && r['Member ref']) { r['Photo link'] = photoLink_(r['Member ref']); writeMember_(m.sh, r); n++; }
  });
  Logger.log('Photo links filled in for ' + n + ' members.');
}

/**
 * Renames the membership form's response tab in the private spreadsheet (default
 * "Form responses") and updates the script's record of its name, so leaving still
 * deletes the right rows. Safe to run again.
 */
function renameResponsesTab(newName) {
  newName = (typeof newName === 'string' && newName.trim()) ? newName.trim() : 'Form responses';
  const props = PropertiesService.getScriptProperties();
  const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
  const oldName = props.getProperty('RESPONSES_A_TAB') || '';
  const sh = ss.getSheetByName(oldName);
  if (!sh) {
    if (ss.getSheetByName(newName)) {
      props.setProperty('RESPONSES_A_TAB', newName);
      Logger.log('The tab is already called "' + newName + '". The script now uses that name.');
      return;
    }
    throw new Error('No tab called "' + oldName + '" in the private spreadsheet. If you renamed it by hand, ' +
                    'run renameResponsesTab again after changing the name back.');
  }
  if (oldName === newName) { Logger.log('Already called "' + newName + '". Nothing to do.'); return; }
  if (ss.getSheetByName(newName)) throw new Error('There is already a tab called "' + newName + '". Delete or rename it first.');
  sh.setName(newName);
  props.setProperty('RESPONSES_A_TAB', newName);
  Logger.log('Renamed "' + oldName + '" to "' + newName + '", and the script now uses the new name.');
}
