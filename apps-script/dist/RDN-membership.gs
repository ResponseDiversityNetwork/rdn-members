// ===== Invite.gs =====
/**
 * Inviting the existing members to the new system.
 *
 * 1. Import the old list as a tab called "Invites" in the PRIVATE spreadsheet.
 *    Expected columns: Name, Organisation, Country, City, State/Province, Email,
 *    Status, Comments, Date joined.
 * 2. Run prepareInvites(). It adds tracking columns, gives each row a secret member
 *    reference, and flags rows it can't invite (no or invalid email, duplicate email).
 *    The Status and Comments columns are ignored.
 * 3. Run sendTestInvite(). It sends the first row's invitation to CONFIG.ADMIN only.
 * 4. Run startInvites(). It sends about 60 invitations a day (keeping email quota for replies), and
 *    sets a daily timer that continues until everyone is invited. The timer also sends one
 *    reminder REMINDER_AFTER_DAYS later to anyone who hasn't responded.
 *
 * When an invited person submits a form, the response carries their member reference.
 * The submit handler calls markInviteResponded_(ref), which records the reply and
 * returns the old row, so they skip curator approval and keep their "Date joined".
 */

const INVITE_COLS = ['Member ref', 'Invite state', 'Invited at', 'Reminded at', 'Responded at', 'Invite note'];

function invitesSheet_() {
  const sh = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID')).getSheetByName(CONFIG.INVITES_TAB);
  if (!sh) throw new Error('No "' + CONFIG.INVITES_TAB + '" tab in the private spreadsheet. Import the old list first.');
  return sh;
}

/** Reads the Invites tab as objects keyed by header, plus a column-index lookup. */
function readInvites_() {
  const sh = invitesSheet_();
  const values = sh.getDataRange().getValues();
  const headers = values[0].map(h => String(h).trim());
  const col = name => {
    const i = headers.indexOf(name);
    if (i < 0) throw new Error('Column "' + name + '" not found in the Invites tab.');
    return i;
  };
  const rows = values.slice(1).map((v, i) => {
    const o = {_row: i + 2};
    headers.forEach((h, j) => { o[h] = v[j]; });
    return o;
  });
  return {sh, headers, col, rows};
}

function setCell_(inv, row, colName, value) {
  inv.sh.getRange(row._row, inv.col(colName) + 1).setValue(value);
  row[colName] = value;
}

/** Step 2. Safe to run again; existing references and states are kept. */
function prepareInvites() {
  const sh = invitesSheet_();
  const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(h => String(h).trim());
  const missing = INVITE_COLS.filter(c => headers.indexOf(c) < 0);
  if (missing.length) sh.getRange(1, headers.length + 1, 1, missing.length).setValues([missing]);

  const inv = readInvites_();
  const seen = {};
  let ready = 0, flagged = 0;
  inv.rows.forEach(r => {
    if (!r['Member ref']) setCell_(inv, r, 'Member ref', newMemberRef_());
    if (r['Invite state'] && r['Invite state'] !== 'not invitable') return;   // already handled
    const email = String(r['Email'] || '').trim().toLowerCase();
    let note = '';
    if (!email) note = 'no email';
    else if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) note = 'email looks invalid';
    else if (seen[email]) note = 'duplicate of row ' + seen[email];
    if (email && !seen[email]) seen[email] = r._row;
    setCell_(inv, r, 'Invite state', note ? 'not invitable' : 'ready');
    setCell_(inv, r, 'Invite note', note);
    note ? flagged++ : ready++;
  });
  sh.setFrozenRows(1);
  Logger.log(ready + ' rows ready to invite; ' + flagged + ' flagged (see the "Invite note" column).');
}

/** The prefilled answers for one old-list row. */
function inviteAnswers_(r) {
  const a = {};
  a[Q.NAME] = String(r['Name'] || '').trim();
  a[Q.EMAIL] = String(r['Email'] || '').trim();
  a[Q.INSTITUTION] = String(r['Organisation'] || '').trim();
  a[Q.CITY] = String(r['City'] || '').trim();
  a[Q.STATE] = String(r['State/Province'] || '').trim();
  a[Q.COUNTRY] = String(r['Country'] || '').trim();
  a[Q.MEMBER_REF] = r['Member ref'];
  return a;
}

function inviteEmail_(r, isReminder) {
  const first = firstName_(r['Name']);
  const answers = inviteAnswers_(r);
  const linkA = prefillUrl_(formsCache_().a, answers);
  const subject = isReminder ? 'Reminder: your Response Diversity Network membership'
                             : 'Response Diversity Network: your membership in our new system';
  const intro = isReminder
    ? 'A couple of weeks ago we asked you to move your Response Diversity Network membership to our new system. If you have two minutes, please do it now.'
    : 'The Response Diversity Network has a new membership system, with a map of members. ' +
      'We have filled in what we already know about you. Please check it, add a few details about your research, ' +
      'and choose what, if anything, is shown on the map. It takes about two minutes.';
  const paragraphs = [
    'Dear ' + esc_(first) + ',',
    esc_(intro),
    '<b>' + link_(linkA, 'Open my membership form') + '</b> (Google Forms, no sign-in needed). ' +
      'You can add a photo afterwards, with a link in the email we send you.',
    'Nothing about you is shown publicly unless you agree to it in the form. You can change your answers or leave at any time. ' +
      'More about membership and privacy: ' + link_(CONFIG.INFO_URL, CONFIG.INFO_URL),
    'So that our emails reach you, please add ' + esc_(CONFIG.CONTACT_EMAIL) + ' to your contacts. ' +
      'If you no longer want to be part of the network, just reply to this email.',
    'Best wishes,<br>' + esc_(CONFIG.ORG_NAME),
  ];
  return {subject, paragraphs};
}

let FORMS_CACHE_ = null;
function formsCache_() {
  if (!FORMS_CACHE_) FORMS_CACHE_ = {a: FormApp.openById(prop_('FORM_A_ID'))};
  return FORMS_CACHE_;
}

function esc_(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
}

function sendInvite_(to, r, isReminder) {
  const m = inviteEmail_(r, isReminder);
  const html = m.paragraphs.map(p => '<p>' + p + '</p>').join('\n');
  const text = m.paragraphs
    .map(p => p.replace(/<a href="([^"]+)">([^<]+)<\/a>/g, '$2: $1').replace(/<br>/g, '\n').replace(/<[^>]+>/g, ''))
    .map(p => p.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'"))
    .join('\n\n');
  // Sent directly (not via mail_) so that a failure is recorded in the Invites tab and retried.
  MailApp.sendEmail(mailOptions_({to, subject: m.subject, body: text, htmlBody: html}));
}

/** Step 3. Sends the first ready row's invitation to CONFIG.ADMIN only. */
function sendTestInvite() {
  const r = readInvites_().rows.find(x => x['Invite state'] === 'ready');
  if (!r) throw new Error('No row is "ready". Run prepareInvites() first.');
  sendInvite_(CONFIG.ADMIN, r, false);
  Logger.log('Test invitation for row ' + r._row + ' (' + r['Name'] + ') sent to ' + CONFIG.CURATOR);
}

/** Step 4. Sends today's batch and sets the daily timer. */
function startInvites() {
  ScriptApp.getProjectTriggers()
    .filter(t => t.getHandlerFunction() === 'inviteTick')
    .forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('inviteTick').timeBased().everyDays(1).atHour(9).create();
  inviteTick();
}

/** Runs daily: reminders first, then new invitations, within the quota. Stops itself when done. */
function inviteTick() {
  const inv = readInvites_();
  let budget = MailApp.getRemainingDailyQuota() - CONFIG.INVITE_EMAIL_RESERVE;
  const now = new Date();
  const dayMs = 24 * 60 * 60 * 1000;
  let sent = 0, reminded = 0;

  inv.rows.forEach(r => {
    if (budget <= 0 || r['Invite state'] !== 'invited' || r['Reminded at']) return;
    if ((now - new Date(r['Invited at'])) < CONFIG.REMINDER_AFTER_DAYS * dayMs) return;
    try {
      sendInvite_(String(r['Email']).trim(), r, true);
      setCell_(inv, r, 'Reminded at', now);
      reminded++; budget--;
    } catch (e) { setCell_(inv, r, 'Invite note', 'reminder failed: ' + e.message); }
  });

  inv.rows.forEach(r => {
    if (budget <= 0 || r['Invite state'] !== 'ready') return;
    try {
      sendInvite_(String(r['Email']).trim(), r, false);
      setCell_(inv, r, 'Invite state', 'invited');
      setCell_(inv, r, 'Invited at', now);
      sent++; budget--;
    } catch (e) { setCell_(inv, r, 'Invite note', 'send failed: ' + e.message); }
  });

  const notYet = inv.rows.filter(r => r['Invite state'] === 'ready').length;
  const awaitingReminder = inv.rows.filter(r => r['Invite state'] === 'invited' && !r['Reminded at']).length;
  if (!notYet && !awaitingReminder) {
    ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'inviteTick')
      .forEach(t => ScriptApp.deleteTrigger(t));
  }
  Logger.log('Today: invited ' + sent + ', reminded ' + reminded + '. Not yet invited: ' + notYet +
             '. Invited, no reply, reminder not yet due: ' + awaitingReminder + '.');
}

/**
 * Called by the submit handler when a new response has a member reference.
 * Returns the old-list row if the reference belongs to an invitation, else null.
 */
function markInviteResponded_(ref) {
  const r = markInviteState_(ref, 'responded');
  return r;
}

/** Sets an invitation's state (if the Invites tab and the reference exist). Returns the row or null. */
function markInviteState_(ref, state) {
  if (!ref) return null;
  const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
  if (!ss.getSheetByName(CONFIG.INVITES_TAB)) return null;
  const inv = readInvites_();
  if (inv.headers.indexOf('Member ref') < 0) return null;
  const r = inv.rows.find(x => x['Member ref'] === ref);
  if (!r) return null;
  if (state === 'responded' && !r['Responded at']) setCell_(inv, r, 'Responded at', new Date());
  setCell_(inv, r, 'Invite state', state);
  return r;
}

/** Progress summary in the log. */
function inviteProgress() {
  const counts = {};
  readInvites_().rows.forEach(r => { const s = r['Invite state'] || '(blank)'; counts[s] = (counts[s] || 0) + 1; });
  Logger.log(JSON.stringify(counts, null, 2));
}

/** Switches off the daily invitation timer (invitations and reminders stop; nothing is deleted). */
function stopInvites() {
  const ts = ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'inviteTick');
  ts.forEach(t => ScriptApp.deleteTrigger(t));
  Logger.log(ts.length ? 'Invitation timer switched off.' : 'No invitation timer was running.');
}


/** The old-list row with this email address, or null (also null if there is no Invites tab). */
function inviteForEmail_(email) {
  email = String(email || '').trim().toLowerCase();
  if (!email) return null;
  const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
  if (!ss.getSheetByName(CONFIG.INVITES_TAB)) return null;
  return readInvites_().rows.find(r => String(r['Email'] || '').trim().toLowerCase() === email) || null;
}

/**
 * Writes an "Invite links" tab: one row per old-list member who has not responded yet,
 * with their personal pre-filled links. Download it as CSV for a mail merge from your own
 * email account (e.g. Word mail merge to Outlook), which organisations' filters trust more.
 */
function exportInviteLinks() {
  const rows = readInvites_().rows.filter(r => ['ready', 'invited'].indexOf(r['Invite state']) >= 0);
  const out = rows.map(r => {
    const a = inviteAnswers_(r);
    return [String(r['Name'] || '').trim(), firstName_(r['Name']), String(r['Email'] || '').trim(),
            prefillUrl_(formsCache_().a, a), r['Invite state']];
  });
  writeTab_(SpreadsheetApp.openById(prop_('PRIVATE_SS_ID')), 'Invite links',
            ['Name', 'FirstName', 'Email', 'Link', 'InviteState'], out);
  Logger.log('Wrote ' + out.length + ' rows to the "Invite links" tab (members who have not responded yet).');
}

// ===== Automation.gs =====
/**
 * What happens when someone submits a form.
 *
 * Triggers (created by installTriggers() in Admin.gs):
 *   onSubmitA:       the membership form (a new response, or an edit through a personal link);
 *   onPhotoSubmit:   the photo form;
 *   onLeaveRequest:  the leave form (Leave.gs);
 *   onSheetEdit:     a curator edits the Members or Leave requests tab;
 *   maintenanceTick: every 15 minutes, retries photos that weren't ready;
 *   dailyRebuild:    rebuilds the public sheet once a day as a safety net.
 *
 * Cases handled by handleSubmit_ (membership form):
 *   new:    a first submission → new Members row. Pending until approved, unless the response
 *           carries the member reference of an invited existing member.
 *   edit:   a submission through someone's personal link (same response) → row updated.
 *   moved:  a new response carrying a known member reference (e.g. an invitation reply after
 *           joining through the join page) → the row moves to the new response; the old one is deleted.
 *   leave:  "Leave the network" ticked → via a personal link, everything is deleted at once;
 *           on a fresh form, a leave request is queued for the curator instead.
 */

function onSubmitA(e) { handleSubmit_('A', e.response); }
function onPhotoSubmit(e) { handlePhotoSubmit_(e.response); }
function onSubmitB(e) { handlePhotoSubmit_(e.response); }   // old trigger name, until installTriggers is re-run

function formFor_(key) { return FormApp.openById(prop_(key === 'A' ? 'FORM_A_ID' : 'FORM_B_ID')); }

/** A response's answers as {question title: value}. Checkbox and upload answers are arrays. */
function answersOf_(response) {
  const a = {};
  response.getItemResponses().forEach(r => { a[r.getItem().getTitle()] = r.getResponse(); });
  return a;
}

function joinList_(v) {
  return Array.isArray(v) ? v.join('; ') : String(v === undefined || v === null ? '' : v).trim();
}

function handleSubmit_(formKey, response) {
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try {
    const ans = answersOf_(response);
    const ref = String(ans[Q.MEMBER_REF] || '').trim();
    const leaving = [].concat(ans[Q.LEAVE] || []).length > 0;
    const m = readMembers_();

    let row = m.rows.find(r => r['Response ID'] === response.getId());
    let kind = row ? 'edit' : null;
    if (!row && ref) {
      row = m.rows.find(r => r['Member ref'] === ref);
      if (row) kind = 'moved';
    }

    if (leaving) {
      if (row) {
        doLeave_(m.sh, row, formKey, response, ans);   // via a personal link: takes effect at once
      } else {
        // A fresh form (no personal link) with "Leave" ticked: discard it, and if the email belongs to a
        // member, queue a leave request for the curator to confirm.
        deleteResponse_(formKey, response.getId(), [String(ans[Q.EMAIL] || '').trim().toLowerCase()]);
        deleteUploads_([].concat(ans[Q.PHOTO] || []));
        queueLeaveRequest_(ans[Q.EMAIL], ans[Q.NAME],
          'Ticked "Leave the network" on a new form, not via their personal link.', true);
      }
      rebuildPublic_();
      return;
    }

    let invite = null;
    if (!row) {
      kind = 'new';
      invite = ref ? markInviteResponded_(ref) : null;
    }

    const old = row ? Object.assign({}, row) : null;
    const rec = row || {};
    ANSWER_TO_COL.forEach(([q, c]) => { rec[c] = joinList_(ans[q]); });
    rec['Mailing list'] = mailingListAnswer_(ans);
    rec['Email'] = String(rec['Email']).trim().toLowerCase();
    rec['Form'] = formKey;
    rec['Response ID'] = response.getId();
    rec['Edit URL'] = response.getEditResponseUrl();
    rec['Updated'] = new Date();
    const notes = [];

    if (kind === 'new') {
      rec['Member ID'] = newMemberId_();
      rec['Member ref'] = invite ? ref : newMemberRef_();
      rec['Approved'] = !!invite;
      rec['Joined'] = invite && invite['Date joined'] ? invite['Date joined'] : new Date();
      if (!invite) {
        // An old-list member who joined through the join page (e.g. their invitation never arrived).
        const listed = inviteForEmail_(rec['Email']);
        if (listed) {
          if (listed['Date joined']) rec['Joined'] = listed['Date joined'];
          // Use their invitation's reference, so that a later reply via the invitation link updates this entry.
          if (listed['Member ref']) rec['Member ref'] = listed['Member ref'];
          markInviteState_(listed['Member ref'], 'responded');
          notes.push('This email is on the old member list (' + listed['Name'] + '). Approve to confirm.');
        }
      }
      const dup = m.rows.find(r => r['Email'] === rec['Email']);
      if (dup) notes.push('Same email as existing member ' + dup['Name'] + ' (' + dup['Member ID'] + ').');
    }

    // Location: geocoded on every submission, so the country name is always Google's spelling.
    const enteredCountry = rec['Country'];
    const g = geocode_(rec['City'], rec['State/Province'], enteredCountry);
    if (g) {
      rec['Lat'] = g.lat; rec['Lon'] = g.lon; rec['Country code'] = g.code;
      rec['Country'] = g.country || enteredCountry; rec['Continent'] = continentFor_(g.code);
    } else {
      rec['Lat'] = ''; rec['Lon'] = ''; rec['Country code'] = ''; rec['Continent'] = '';
      notes.push('Could not find "' + [rec['City'], rec['State/Province'], enteredCountry].filter(Boolean).join(', ') +
                 '" on the map. Correct City/Country in the Members tab.');
    }

    // Photos are handled by the photo form; a membership-form submission leaves them alone.

    // The member's entry moved to a new response: remove the old one.
    if (kind === 'moved' && old['Response ID'] && old['Response ID'] !== rec['Response ID']) {
      deleteResponse_(old['Form'] || 'A', old['Response ID'], [old['Email']]);
    }

    rec['Notes'] = notes.join(' ');
    if (kind === 'new' || !rec['Photo link']) rec['Photo link'] = photoLink_(rec['Member ref']);
    writeMember_(m.sh, rec);

    // Emails
    if (kind === 'new') {
      if (rec['Approved']) {
        emailMember_(rec, response, 'welcome');
        if (isYes_(rec['Mailing list'])) listservNotify_('add', rec);
      } else {
        emailMember_(rec, response, 'received');
        emailCurator_(rec, notes);
      }
    } else if (kind === 'moved') {
      emailMember_(rec, response, 'linkChanged');
    }
    if (old) {
      const emailChanged = old['Email'] !== rec['Email'];
      if (emailChanged) {
        if (kind !== 'moved') emailMember_(rec, response, 'emailChanged');
        emailOldAddress_(old['Email'], rec['Email']);
      }
      if (rec['Approved']) {
        const was = isYes_(old['Mailing list']), now = isYes_(rec['Mailing list']);
        if (!was && now) listservNotify_('add', rec);
        else if (was && !now) listservNotify_('remove', old);
        else if (was && now && emailChanged) listservNotify_('change', rec, old['Email']);
      }
      if (notes.length && !old['Notes']) emailCurator_(rec, notes, true);
    }

    rebuildPublic_();
  } finally {
    lock.releaseLock();
  }
}

/**
 * The photo form: identifies the member by the reference in the link from their email, then
 * publishes the new photo (replacing any old one) or removes it. The form response itself is not kept.
 */
function handlePhotoSubmit_(response) {
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try {
    const ans = answersOf_(response);
    const ref = String(ans[Q.MEMBER_REF] || '').trim();
    const uploads = [].concat(ans[Q.PHOTO] || []);
    const remove = [].concat(ans[Q.REMOVE_PHOTO] || []).length > 0;
    try { formFor_('B').deleteResponse(response.getId()); } catch (e) { /* ignore */ }
    const m = readMembers_();
    const rec = ref ? m.rows.find(r => r['Member ref'] === ref) : null;
    if (!rec) {
      deleteUploads_(uploads);
      mail_(CONFIG.CURATOR, '[RDN] Photo discarded: unknown member reference', [
        'Someone used the photo form without a valid member reference (' + esc_(ref || 'empty') + '), so the photo was discarded. ' +
        'If they write to you, send them the photo link from their own membership emails.']);
      return;
    }
    const oldUploads = listOf_(rec['Photo uploads']);
    if (remove) {
      deleteUploads_(oldUploads.concat(uploads));
      deletePublicPhoto_(rec['Member ID']);
      rec['Photo uploads'] = ''; rec['Photo URL'] = ''; rec['Photo pending'] = false;
    } else if (uploads.length) {
      deleteUploads_(oldUploads.filter(id => uploads.indexOf(id) < 0));
      const url = publishPhoto_(uploads[0], rec['Member ID']);
      rec['Photo uploads'] = uploads.join('; ');
      rec['Photo URL'] = url || '';
      rec['Photo pending'] = !url;
    } else {
      return;   // nothing to do
    }
    rec['Updated'] = new Date();
    writeMember_(m.sh, rec);
    rebuildPublic_();
  } finally {
    lock.releaseLock();
  }
}

/** Deletes everything about a member who ticked "Leave the network". */
function doLeave_(sh, row, formKey, response, ans) {
  const email = String(ans[Q.EMAIL] || '').trim().toLowerCase();
  const emails = [email].concat(row ? [row['Email']] : []);
  // The response that was just submitted
  deleteResponse_(formKey, response.getId(), emails);
  deleteUploads_([].concat(ans[Q.PHOTO] || []));
  if (row) removeMember_(sh, row, emails, response.getId());
  if (email) emailLeft_(email, ans[Q.NAME]);
}

/**
 * Deletes everything about a member: their form response and its sheet row, photos,
 * Members row; marks their invitation "left"; asks the listserv manager to unsubscribe them.
 */
function removeMember_(sh, row, emails, skipResponseId) {
  emails = (emails || []).concat([row['Email']]);
  if (row['Response ID'] && row['Response ID'] !== skipResponseId) deleteResponse_(row['Form'], row['Response ID'], emails);
  deleteUploads_(listOf_(row['Photo uploads']));
  deletePublicPhoto_(row['Member ID']);
  markInviteState_(row['Member ref'], 'left');
  if (row['Approved'] === true && isYes_(row['Mailing list'])) listservNotify_('remove', row);
  deleteMemberRow_(sh, row);
}

/** Deletes a response from its form and its row in the form's responses tab. */
function deleteResponse_(formKey, responseId, emails) {
  try { formFor_(formKey).deleteResponse(responseId); } catch (e) { /* already gone */ }
  const tabName = PropertiesService.getScriptProperties().getProperty(formKey === 'A' ? 'RESPONSES_A_TAB' : 'RESPONSES_B_TAB');
  const sh = tabName && SpreadsheetApp.openById(prop_('PRIVATE_SS_ID')).getSheetByName(tabName);
  if (!sh || sh.getLastRow() < 2) return;
  const values = sh.getDataRange().getValues();
  const col = values[0].map(String).indexOf(Q.EMAIL);
  if (col < 0) return;
  const targets = emails.filter(Boolean).map(s => String(s).trim().toLowerCase());
  for (let i = values.length - 1; i >= 1; i--) {
    if (targets.indexOf(String(values[i][col]).trim().toLowerCase()) >= 0) deleteRowsSafely_(sh, i + 1, 1);
  }
}

/**
 * Curator edits in the Members tab. Ticking "Approved" publishes the member and
 * emails them; changing City / State/Province / Country geocodes the row again.
 */
function onSheetEdit(e) {
  const sh = e.range.getSheet();
  if (sh.getName() === LEAVE_TAB && e.range.getRow() >= 2) return onLeaveSheetEdit_(e);
  if (sh.getName() !== 'Members' || e.range.getRow() < 2) return;
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try {
    const firstCol = e.range.getColumn(), lastCol = firstCol + e.range.getNumColumns() - 1;
    const touched = c => { const i = MEMBER_COLS.indexOf(c) + 1; return i >= firstCol && i <= lastCol; };
    const rows = readMembers_().rows.filter(r => r._row >= e.range.getRow() &&
                                                 r._row < e.range.getRow() + e.range.getNumRows());
    rows.forEach(rec => {
      if (touched('City') || touched('State/Province') || touched('Country')) {
        const g = geocode_(rec['City'], rec['State/Province'], rec['Country']);
        if (g) {
          rec['Lat'] = g.lat; rec['Lon'] = g.lon; rec['Country code'] = g.code;
          rec['Country'] = g.country; rec['Continent'] = continentFor_(g.code);
          rec['Notes'] = '';
        } else {
          rec['Notes'] = 'Still could not find this place on the map.';
        }
        writeMember_(sh, rec);
      }
      if (touched('Approved') && rec['Approved'] === true && String(e.oldValue).toUpperCase() !== 'TRUE') {
        emailApproved_(rec);
        if (isYes_(rec['Mailing list'])) listservNotify_('add', rec);
      }
    });
    rebuildPublic_();
  } finally {
    lock.releaseLock();
  }
}

/** Every 15 minutes: publishes photos whose thumbnail wasn't ready at submit time. */
function maintenanceTick() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return;
  try {
    const m = readMembers_();
    let changed = false;
    m.rows.filter(r => r['Photo pending'] === true).forEach(rec => {
      const ids = listOf_(rec['Photo uploads']);
      if (!ids.length) { rec['Photo pending'] = false; writeMember_(m.sh, rec); return; }
      const url = publishPhoto_(ids[0], rec['Member ID']);
      const age = Date.now() - new Date(rec['Updated']).getTime();
      if (url || age > 2 * 24 * 3600 * 1000) {   // give up after 2 days
        rec['Photo URL'] = url || '';
        rec['Photo pending'] = false;
        if (!url) rec['Notes'] = (rec['Notes'] ? rec['Notes'] + ' ' : '') + 'Photo could not be processed.';
        writeMember_(m.sh, rec);
        changed = true;
      }
    });
    if (changed) rebuildPublic_();
  } finally {
    lock.releaseLock();
  }
}

function dailyRebuild() {
  const lock = LockService.getScriptLock();
  lock.waitLock(60000);
  try { rebuildPublic_(); } finally { lock.releaseLock(); }
}

// ===== Emails.gs =====
/**
 * All emails the automation sends. Edit the wording here.
 * Paragraphs are small bits of HTML; the plain-text version is made from them.
 */

function mail_(to, subject, paragraphs) {
  if (CONFIG.TEST_PHASE) {
    paragraphs = ['<i>This is a test of the new RDN membership system. Test entries will be deleted before launch. ' +
                  'Thank you for helping!</i>'].concat(paragraphs);
  }
  const html = paragraphs.map(p => '<p>' + p + '</p>').join('\n');
  const text = paragraphs
    .map(p => p.replace(/<a href="([^"]+)">([^<]+)<\/a>/g, '$2: $1').replace(/<br>/g, '\n').replace(/<[^>]+>/g, ''))
    .map(p => p.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'"))
    .join('\n\n');
  try {
    MailApp.sendEmail(mailOptions_({to, subject, body: text, htmlBody: html}));
  } catch (e) {
    recordFailedEmail_(to, subject, e);
  }
}

/** Lists an email that couldn't be sent (e.g. daily limit used up) in the "Failed emails" tab. */
function recordFailedEmail_(to, subject, e) {
  console.error('Email to ' + to + ' ("' + subject + '") failed: ' + e.message);
  const ss = SpreadsheetApp.openById(prop_('PRIVATE_SS_ID'));
  const sh = ss.getSheetByName('Failed emails') || ss.insertSheet('Failed emails');
  if (sh.getLastRow() === 0) sh.appendRow(['When', 'To', 'Subject', 'Error']);
  sh.appendRow([new Date(), to, subject, e.message]);
}

/** Adds the sender name, and a reply-to only if one is configured. */
function mailOptions_(o) {
  o.name = CONFIG.SENDER_NAME;
  if (CONFIG.REPLY_TO) o.replyTo = CONFIG.REPLY_TO;
  return o;
}

function link_(url, label) { return '<a href="' + esc_(url) + '">' + esc_(label) + '</a>'; }

function firstName_(name) { return String(name || '').trim().split(/\s+/)[0] || 'colleague'; }

/** The paragraphs every member email ends with: personal link, photo link, footer. */
function memberLinks_(rec) {
  const hasPhoto = !!(rec['Photo URL'] || rec['Photo pending']);
  return [
    'Your personal link, for changing your answers or leaving the network: ' + link_(rec['Edit URL'], 'my membership entry') +
      '. Please keep this email.',
    (hasPhoto ? 'To change or remove your photo: ' : 'To add a photo to your map entry: ') +
      link_(photoLink_(rec['Member ref']), 'photo form') + ' (Google asks you to sign in to upload a photo).',
    'Best wishes,<br>' + esc_(CONFIG.ORG_NAME) + '<br><small>Membership and privacy: ' + esc_(CONFIG.INFO_URL) + '</small>',
  ];
}

function emailMember_(rec, response, kind) {
  const hi = 'Dear ' + esc_(firstName_(rec['Name'])) + ',';
  const onMap = isYes_(rec['Show on map']);
  const subjects = {
    received: 'Response Diversity Network: membership received',
    welcome: 'Response Diversity Network: membership details saved',
    linkChanged: 'Response Diversity Network: membership details saved',
    emailChanged: 'Response Diversity Network: email address changed',
  };
  const bodies = {
    received: 'Thank you for joining the Response Diversity Network. A curator will check your entry, usually within a few days. ' +
      (onMap ? 'After that you will appear on the member map.' : 'You chose not to appear on the public member map.'),
    welcome: 'Thank you for updating your Response Diversity Network membership. ' +
      (onMap ? 'You will appear on the member map within about 10 minutes.' : 'You chose not to appear on the public member map.'),
    linkChanged: 'Thank you, your membership details are saved. Your personal link has changed: please use the one below.',
    emailChanged: 'The email address on your membership is now this one. We have also let your previous address know.',
  };
  const list = kind === 'welcome' ? listLine_(rec) : [];
  mail_(rec['Email'], subjects[kind], [hi, bodies[kind]].concat(list, memberLinks_(rec)));
}

/** For members on the mailing list (once it is switched on): one line about the list. */
function listLine_(rec) {
  if (!CONFIG.LISTSERV_NOTIFY_EACH || !isYes_(rec['Mailing list'])) return [];
  return ['You are on the RDN mailing list, ' + esc_(CONFIG.LIST_ADDRESS) + '. To leave it, open your personal link ' +
          'and tick \u201c' + esc_(OPTIONS.MAILING_OPT_OUT) + '\u201d.'];
}

function emailApproved_(rec) {
  const onMap = isYes_(rec['Show on map']);
  mail_(rec['Email'], 'Response Diversity Network: membership confirmed', [
    'Dear ' + esc_(firstName_(rec['Name'])) + ',',
    'Your membership of the Response Diversity Network has been confirmed. ' +
      (onMap ? 'You will appear on the member map within about 10 minutes.' : 'You chose not to appear on the public member map.'),
  ].concat(listLine_(rec), memberLinks_(rec)));
}

function emailOldAddress_(oldEmail, newEmail) {
  if (!oldEmail) return;
  mail_(oldEmail, 'Response Diversity Network: email address changed', [
    'The email address on your Response Diversity Network membership was changed from this address to ' +
      esc_(newEmail) + '.',
    'If you did not make this change, please reply to this email.',
    'Best wishes,<br>' + esc_(CONFIG.ORG_NAME),
  ]);
}

function emailLeft_(email, name) {
